# Copy to server/config.env (which is git-ignored) and fill in the values.
# Only the food icon settings are listed with defaults; see server.js for the rest.

DB=
SECRET=
JWT_SECRET=

# Claude API key. Keep it here only; never in client code or in a committed file.
ANTHROPIC_API_KEY=
# Model used by the app's AI features.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Food icons (all optional; defaults shown) ---
# Model for icon classification. Defaults to ANTHROPIC_MODEL.
ICON_AI_MODEL=
ICON_AI_MAX_TOKENS=8000
# low | medium | high | xhigh | max
ICON_AI_EFFORT=low
ICON_AI_TIMEOUT_MS=30000
# On a safety refusal, retry on a suitable model. Set to false for models without server-side fallbacks (e.g. Haiku).
ICON_AI_REFUSAL_FALLBACK=true
# Most food names accepted per request.
ICON_AI_MAX_NAMES=50
# Most answers the server keeps in memory.
ICON_AI_CACHE_SIZE=2000
# Path to the icon manifest. Defaults to client/src/icons/manifest.json.
ICON_MANIFEST_PATH=
