# Food icon settings for the client. Copy to client/.env to change any of them.
# All are optional; the values shown are the defaults.

# Backend endpoint that asks Claude for icons (the API key stays on the server).
VITE_ICON_ENDPOINT=/api/icons/classify
# Colour of the fallback icon when Claude cannot answer.
VITE_ICON_FALLBACK_COLOR=#D9D4C7
# localStorage key for cached answers. Change it to make every browser ask again.
VITE_ICON_CACHE_KEY=fullCircle.foodIcons.v2
# "false" keeps answers in memory only.
VITE_ICON_PERSIST_CACHE=true
VITE_ICON_CACHE_MAX_ENTRIES=2000
# Names requested within this many milliseconds go in one request, at most VITE_ICON_BATCH_SIZE.
VITE_ICON_BATCH_DELAY_MS=60
VITE_ICON_BATCH_SIZE=50
